 "breadcrumbs": "[{\"label\": _(\"Jobs\"), \"route\":\"jobs\"}]",
 "button_label": "Save",
 "client_script": "frappe.ready(function () {\r\n  const set_full_name = () => {\r\n    const first = frappe.web_form.get_value(\"first_name\") || \"\";\r\n    const father = frappe.web_form.get_value(\"father_name\") || \"\";\r\n    const family = frappe.web_form.get_value(\"family_name\") || \"\";\r\n\r\n    // Full name rule: First + Father + Family (skip blanks)\r\n    const full = [first, father, family].filter(Boolean).join(\" \").trim();\r\n\r\n    if (full) {\r\n      frappe.web_form.set_value(\"full_name\", full);\r\n\r\n      // Signature name same as full name if empty\r\n      if (!frappe.web_form.get_value(\"applicant_signature_name\")) {\r\n        frappe.web_form.set_value(\"applicant_signature_name\", full);\r\n      }\r\n    }\r\n  };\r\n\r\n  // Run on load + whenever name fields change\r\n  set_full_name();\r\n  [\"first_name\", \"father_name\", \"family_name\"].forEach((f) => {\r\n    frappe.web_form.on(f, set_full_name);\r\n  });\r\n});\r\n",
