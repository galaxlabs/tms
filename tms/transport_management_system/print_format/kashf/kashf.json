 "html": "<h2>Kashf</h2>\n<table class=\"table table-bordered\">\n  <tr><th>Trip Invoice</th><td>{{ doc.name }}</td><th>Trip</th><td>{{ doc.trip }}</td></tr>\n  <tr><th>Passenger</th><td>{{ doc.invoice_passenger_name or '' }}</td><th>Mobile</th><td>{{ doc.invoice_passenger_mobile or '' }}</td></tr>\n  <tr><th>From</th><td>{{ doc.from_location or '' }}</td><th>To</th><td>{{ doc.to_location or '' }}</td></tr>\n</table>\n<table class=\"table table-bordered\">\n  <thead><tr><th>Description</th><th>Qty</th><th>Rate</th><th>Net</th><th>VAT</th><th>Total</th></tr></thead>\n  <tbody>\n  {% for row in doc.items %}\n    <tr>\n      <td>{{ row.description or row.item_name or row.item_code or '' }}</td>\n      <td>{{ row.qty }}</td>\n      <td>{{ row.rate }}</td>\n      <td>{{ row.amount }}</td>\n      <td>{{ row.vat_amount }}</td>\n      <td>{{ row.total_amount }}</td>\n    </tr>\n  {% endfor %}\n  </tbody>\n</table>\n<table class=\"table table-bordered\">\n  <tr><th>Net Total</th><td>{{ doc.net_total }}</td></tr>\n  <tr><th>VAT</th><td>{{ doc.vat_amount }}</td></tr>\n  <tr><th>Grand Total</th><td>{{ doc.grand_total }}</td></tr>\n</table>",
