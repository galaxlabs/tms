 "font_size": 14,
 "html": "<style>\r\n@import url('https://fonts.googleapis.com/css2?family=Ubuntu:wght@300;400;500;700&display=swap');\r\n\r\n@page { size: A4; margin: 10mm 8mm 10mm 8mm; }\r\n\r\nbody { font-family: 'Ubuntu', sans-serif; font-size: 13px; }\r\nhr { border: 0; border-top: 1px solid #ddd; margin: 8px 0; }\r\n\r\n.header-wrap { display: flex; justify-content: space-between; align-items: flex-start; }\r\n.header-left { width: 63%; text-align: left; direction:ltr; }\r\n.header-right { width: 35%; text-align: right; }\r\n.company-names .ar {\r\n  margin: 0;\r\n  font-size: 22px;\r\n  font-family:'Cascadia Mono', monospace;\r\n  font-weight: 500;\r\n  color: #000;\r\n  direction: rtl;\r\n}\r\n.company-name { font-size: 16px; font-weight: 700; margin:0; }\r\n.small { font-size: 12px; color:#333; }\r\n\r\n.qr { width: 115px; height: 115px; }\r\n\r\n.table { width:100%; border-collapse: collapse; table-layout: fixed; direction:ltr; }\r\n.table th { background:#f3f3f3; border:1px solid #bbb; padding:6px; text-align:left; font-weight:700; }\r\n.table td { border:1px solid #bbb; padding:6px; text-align:left; vertical-align:top; }\r\n\r\n.text-right { text-align:right; }\r\n.totals { width: 55%; float:right; }\r\n.clear { clear: both; }\r\n</style>\r\n\r\n{% set company = frappe.get_doc(\"Company\", doc.company) %}\r\n\r\n<div class=\"header-wrap\">\r\n  <div class=\"header-left\">\r\n    <p class=\"company-name\">{{ company.company_name }}</p>\r\n    {% if company.company_name_arabic %}\r\n      <div class=\"ar\">{{ company.company_name_arabic }}</div>\r\n    {% endif %}\r\n    <div class=\"small\"><b>VAT:</b> {{ doc.company_tax_id or company.tax_id or \"\" }}</div>\r\n    {% if company.registration_details %}\r\n      <div class=\"small\"><b>CR:</b> {{ company.registration_details }}</div>\r\n    {% endif %}\r\n    {% if doc.company_address_display %}\r\n      <div class=\"small\" style=\"margin-top:4px;\">{{ doc.company_address_display | safe }}</div>\r\n    {% endif %}\r\n  </div>\r\n\r\n  <div class=\"header-right\">\r\n    <div style=\"font-weight:700;\">Simplified Tax Invoice</div>\r\n    {% if doc.zatca_qr_payload %}\r\n  <img class=\"qr\"\r\n       src=\"https://api.qrserver.com/v1/create-qr-code/?size=140x140&data={{ doc.zatca_qr_payload | urlencode }}\"\r\n       alt=\"QR\">\r\n{% endif %}\r\n  </div>\r\n</div>\r\n\r\n<hr>\r\n\r\n<div class=\"row\" style=\"display:flex; justify-content:space-between;\">\r\n  <div style=\"width:48%;\">\r\n    <div><b>Invoice No:</b> {{ doc.name }}</div>\r\n    <div><b>Date:</b> {{ doc.posting_date }} {{ doc.posting_time }}</div>\r\n  </div>\r\n  <div style=\"width:48%;\" class=\"text-right\">\r\n    <div><b>Bill To:</b> {{ doc.customer_name }}</div>\r\n    {% if doc.tax_id %}\r\n      <div><b>Customer VAT:</b> {{ doc.tax_id }}</div>\r\n    {% endif %}\r\n  </div>\r\n</div>\r\n\r\n<hr>\r\n\r\n<table class=\"table\">\r\n  <thead>\r\n    <tr>\r\n      <th style=\"width:45%;\">Item</th>\r\n      <th style=\"width:18%;\" class=\"text-right\">Rate</th>\r\n      <th style=\"width:12%;\" class=\"text-right\">Qty</th>\r\n      <th style=\"width:25%;\" class=\"text-right\">Amount</th>\r\n    </tr>\r\n  </thead>\r\n  <tbody>\r\n    {% for row in doc.items %}\r\n    <tr>\r\n      <td>{{ row.item_name }}</td>\r\n      <td class=\"text-right\">{{ frappe.format(row.rate, {\"fieldtype\":\"Currency\"}, doc) }}</td>\r\n      <td class=\"text-right\">{{ row.qty }}</td>\r\n      <td class=\"text-right\">{{ frappe.format(row.amount, {\"fieldtype\":\"Currency\"}, doc) }}</td>\r\n    </tr>\r\n    {% endfor %}\r\n  </tbody>\r\n</table>\r\n\r\n<br>\r\n\r\n<table class=\"table totals\">\r\n  <tr>\r\n    <td><b>Net Total</b></td>\r\n    <td class=\"text-right\">{{ frappe.format(doc.net_total, {\"fieldtype\":\"Currency\"}, doc) }}</td>\r\n  </tr>\r\n  <tr>\r\n    <td><b>VAT (15%)</b></td>\r\n    <td class=\"text-right\">{{ frappe.format(doc.total_taxes_and_charges, {\"fieldtype\":\"Currency\"}, doc) }}</td>\r\n  </tr>\r\n  <tr>\r\n    <td><b>Grand Total</b></td>\r\n    <td class=\"text-right\"><b>{{ frappe.format(doc.grand_total, {\"fieldtype\":\"Currency\"}, doc) }}</b></td>\r\n  </tr>\r\n  <tr>\r\n    <td>Paid</td>\r\n    <td class=\"text-right\">{{ frappe.format(doc.paid_amount or 0, {\"fieldtype\":\"Currency\"}, doc) }}</td>\r\n  </tr>\r\n  <tr>\r\n    <td>Outstanding</td>\r\n    <td class=\"text-right\">{{ frappe.format(doc.outstanding_amount, {\"fieldtype\":\"Currency\"}, doc) }}</td>\r\n  </tr>\r\n</table>\r\n\r\n<div class=\"clear\"></div>\r\n",
