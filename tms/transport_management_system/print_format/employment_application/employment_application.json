{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-02-01 20:06:40.272391",
 "css": "\r\n  @media print {\r\n    .page-break { page-break-before: always; }\r\n  }\r\n\r\n  body { font-family: Arial, sans-serif; font-size: 11px; color:#000; }\r\n  .title { text-align:center; font-weight:700; font-size:16px; margin: 6px 0 0; }\r\n  .sub   { text-align:center; font-weight:700; font-size:14px; margin: 2px 0 10px; }\r\n  .box   { border:2px solid #000; padding:8px; }\r\n  table  { width:100%; border-collapse:collapse; }\r\n  td     { border:1px solid #000; padding:4px 6px; vertical-align:top; }\r\n  .lbl   { font-weight:700; white-space:nowrap; }\r\n  .small { font-size:10px; }\r\n  .photo { width:110px; height:130px; border:1px solid #000; object-fit:cover; }\r\n  .line  { display:inline-block; min-width:180px; border-bottom:1px solid #000; height:14px; }\r\n  .rtl   { direction: rtl; unicode-bidi: embed; }\r\n  .center { text-align:center; }\r\n  .muted { color:#333; }\r\n  .section-h { font-weight:700; margin: 6px 0 4px; }",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Employment Application",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "{% set company_name = frappe.db.get_value(\"Company\", doc.company, \"company_name\") or doc.company %}\r\n\r\n<!-- ========================= PAGE 1 ========================= -->\r\n<div style=\"border:1px solid red;\">DEBUG PAGE-1 START</div>\r\n\r\n<div style=\"display:flex; justify-content:space-between; align-items:flex-start;\">\r\n  <div class=\"small\"><b>{{ company_name or \"\" }}</b></div>\r\n  <!--<div class=\"small\"><b>{{ doc.company or \"\" }}</b></div>-->\r\n  <div class=\"small rtl\"><b>\u0634\u0631\u0643\u0629 \u0627\u0644\u062a\u0645\u064a\u0632 \u0627\u0644\u0634\u0627\u0645\u0644\u0629 \u0627\u0644\u0631\u0627\u0626\u062f\u0629 \u0644\u0644\u0646\u0642\u0644</b></div>\r\n</div>\r\n\r\n<div class=\"title rtl\">\u0637\u0644\u0628 \u062a\u0648\u0638\u064a\u0641</div>\r\n<div class=\"sub\">EMPLOYMENT APPLICATION</div>\r\n\r\n<div class=\"box\">\r\n\r\n  <!-- Top row: photo + favorite city + position -->\r\n  <table>\r\n    <tr>\r\n      <td style=\"width:22%; text-align:center;\">\r\n        {% if doc.photo %}\r\n          <img class=\"photo\" src=\"{{ doc.photo }}\">\r\n        {% else %}\r\n          <div class=\"small rtl\">\u0635\u0648\u0631\u0629 \u0634\u0645\u0633\u064a\u0629 \u0625\u0646 \u0648\u062c\u062f</div>\r\n          <div style=\"height:110px;\"></div>\r\n        {% endif %}\r\n      </td>\r\n\r\n      <td style=\"width:38%;\">\r\n        <div class=\"lbl\">favorite city <span class=\"rtl\">\u0627\u0644\u0645\u062f\u064a\u0646\u0629 \u0627\u0644\u0645\u0641\u0636\u0644\u0629</span></div>\r\n        <div class=\"small\">1- <span class=\"line\">{{ doc.favorite_city_1 or \"\" }}</span></div>\r\n        <div class=\"small\">2- <span class=\"line\">{{ doc.favorite_city_2 or \"\" }}</span></div>\r\n      </td>\r\n\r\n      <td style=\"width:40%;\">\r\n        <div class=\"lbl rtl\">\u0627\u0644\u0648\u0638\u064a\u0641\u0629 \u0627\u0644\u0645\u0637\u0644\u0648\u0628\u0629 : <span class=\"small\">Position Applied For :</span></div>\r\n        <div style=\"margin-top:8px;\">\r\n          <span class=\"line\" style=\"min-width:100%;\">{{ doc.position_applied_for or \"\" }}</span>\r\n        </div>\r\n      </td>\r\n    </tr>\r\n  </table>\r\n\r\n  <!-- Names row -->\r\n  <table style=\"margin-top:6px;\">\r\n    <tr>\r\n      <td class=\"lbl\">First Name <span class=\"rtl\">\u0627\u0644\u0627\u0633\u0645 \u0627\u0644\u0623\u0648\u0644</span></td>\r\n      <td class=\"lbl\">Fathers Name <span class=\"rtl\">\u0627\u0633\u0645 \u0627\u0644\u0623\u0628</span></td>\r\n      <td class=\"lbl\">Grand father's <span class=\"rtl\">\u0627\u0633\u0645 \u0627\u0644\u062c\u062f</span></td>\r\n      <td class=\"lbl\">Family Name <span class=\"rtl\">\u0627\u0633\u0645 \u0627\u0644\u0639\u0627\u0626\u0644\u0629</span></td>\r\n    </tr>\r\n    <tr>\r\n      <td>{{ doc.first_name or \"\" }}</td>\r\n      <td>{{ doc.father_name or \"\" }}</td>\r\n      <td>{{ doc.grand_father_name or \"\" }}</td>\r\n      <td>{{ doc.family_name or \"\" }}</td>\r\n    </tr>\r\n  </table>\r\n\r\n  <!-- Birth / nationality / religion -->\r\n  <table style=\"margin-top:6px;\">\r\n    <tr>\r\n      <td class=\"lbl\">Date of birth <span class=\"rtl\">\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0645\u064a\u0644\u0627\u062f</span></td>\r\n      <td class=\"lbl\">Place of birth <span class=\"rtl\">\u0645\u0643\u0627\u0646 \u0627\u0644\u0645\u064a\u0644\u0627\u062f</span></td>\r\n      <td class=\"lbl\">Nationality <span class=\"rtl\">\u0627\u0644\u062c\u0646\u0633\u064a\u0629</span></td>\r\n      <td class=\"lbl\">Religion <span class=\"rtl\">\u0627\u0644\u062f\u064a\u0627\u0646\u0629</span></td>\r\n    </tr>\r\n    <tr>\r\n      <td>{% if doc.date_of_birth %}{{ frappe.utils.formatdate(doc.date_of_birth) }}{% endif %}</td>\r\n      <td>{{ doc.place_of_birth or \"\" }}</td>\r\n      <td>{{ doc.nationality or \"\" }}</td>\r\n      <td>{{ doc.religion or \"\" }}</td>\r\n    </tr>\r\n  </table>\r\n\r\n  <!-- ID / Passport -->\r\n  <table style=\"margin-top:6px;\">\r\n    <tr>\r\n      <td class=\"lbl rtl\">\u0631\u0642\u0645 \u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0623\u062d\u0648\u0627\u0644 \u0627\u0644\u0645\u062f\u0646\u064a\u0629/ \u0627\u0644\u0625\u0642\u0627\u0645\u0629 <span class=\"small\">No. of ID / Eqamah</span></td>\r\n      <td class=\"lbl rtl\">\u0631\u0642\u0645 \u0627\u0644\u062c\u0648\u0627\u0632 <span class=\"small\">No. of Passport</span></td>\r\n    </tr>\r\n    <tr>\r\n      <td>{{ doc.id_iqama_no or \"\" }}</td>\r\n      <td>{{ doc.passport_no or \"\" }}</td>\r\n    </tr>\r\n  </table>\r\n\r\n  <!-- Mobile / Email -->\r\n  <table style=\"margin-top:6px;\">\r\n    <tr>\r\n      <td class=\"lbl\">Mobile No. <span class=\"rtl\">\u0627\u0644\u062c\u0648\u0627\u0644</span></td>\r\n      <td class=\"lbl\">E-Mail <span class=\"rtl\">\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a</span></td>\r\n    </tr>\r\n    <tr>\r\n      <td>{{ doc.mobile or \"\" }}</td>\r\n      <td>{{ doc.email or \"\" }}</td>\r\n    </tr>\r\n  </table>\r\n\r\n  <!-- Address / IBAN -->\r\n  <table style=\"margin-top:6px;\">\r\n    <tr>\r\n      <td class=\"lbl rtl\">\u0627\u0644\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0648\u0637\u0646\u064a <span class=\"small\">National Address</span></td>\r\n    </tr>\r\n    <tr>\r\n      <td>{{ doc.national_address or \"\" }}</td>\r\n    </tr>\r\n  </table>\r\n\r\n  <table style=\"margin-top:6px;\">\r\n    <tr>\r\n      <td class=\"lbl rtl\">\u0631\u0642\u0645 \u0627\u0644\u062d\u0633\u0627\u0628 \u0627\u0644\u0628\u0646\u0643\u064a \u0627\u0644\u0622\u064a\u0628\u0627\u0646 <span class=\"small\">Bank Account number Iban</span></td>\r\n    </tr>\r\n    <tr>\r\n      <td>{{ doc.iban or \"\" }}</td>\r\n    </tr>\r\n  </table>\r\n\r\n  <!-- Marital + dependents -->\r\n  <table style=\"margin-top:6px;\">\r\n    <tr>\r\n      <td class=\"lbl rtl\">\u0627\u0644\u062d\u0627\u0644\u0629 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639\u064a\u0629 <span class=\"small\">Marital status</span></td>\r\n      <td class=\"lbl rtl\">\u0647\u0644 \u062a\u0639\u0648\u0644 \u0623\u062d\u062f\u0627 \u061f <span class=\"small\">Have you any dependents?</span></td>\r\n    </tr>\r\n    <tr>\r\n      <td>{{ doc.marital_status or \"\" }}</td>\r\n      <td>\r\n        {% if doc.has_dependents %}YES / \u0646\u0639\u0645{% else %}NO / \u0644\u0627{% endif %}\r\n      </td>\r\n    </tr>\r\n  </table>\r\n\r\n  {% if doc.has_dependents and doc.dependents %}\r\n    <div class=\"small rtl\" style=\"margin-top:8px;\">\u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u0627\u0644\u0625\u062c\u0627\u0628\u0629 \"\u0646\u0639\u0645\" \u0628\u064a\u0646 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u062a\u0627\u0644\u064a\u0629</div>\r\n    <table>\r\n      <tr>\r\n        <td class=\"lbl\">Name <span class=\"rtl\">\u0627\u0644\u0627\u0633\u0645</span></td>\r\n        <td class=\"lbl\">Age <span class=\"rtl\">\u0627\u0644\u0633\u0646</span></td>\r\n        <td class=\"lbl\">Relation <span class=\"rtl\">\u0627\u0644\u0642\u0631\u0627\u0628\u0629</span></td>\r\n      </tr>\r\n      {% for d in doc.dependents %}\r\n        <tr>\r\n          <td>{{ d.dependent_name or \"\" }}</td>\r\n          <td>{{ d.age or \"\" }}</td>\r\n          <td>{{ d.relation or \"\" }}</td>\r\n        </tr>\r\n      {% endfor %}\r\n    </table>\r\n  {% endif %}\r\n\r\n</div>\r\n\r\n<div style=\"page-break-after: always;\"></div>\r\n\r\n<!-- ========================= PAGE 2 ========================= -->\r\n\r\n<div style=\"display:flex; justify-content:space-between; align-items:flex-start;\">\r\n  <div class=\"small\"><b>{{ company_name or \"\" }}</b></div>\r\n  <div class=\"small rtl\"><b>\u0634\u0631\u0643\u0629 \u0627\u0644\u062a\u0645\u064a\u0632 \u0627\u0644\u0634\u0627\u0645\u0644\u0629 \u0627\u0644\u0631\u0627\u0626\u062f\u0629 \u0644\u0644\u0646\u0642\u0644</b></div>\r\n</div>\r\n\r\n<div class=\"section-h rtl\" style=\"text-align:center; font-size:13px; margin-top:6px;\">\r\n  \u0633\u062c\u0644 \u0627\u0644\u0648\u0638\u0627\u0626\u0641 \u0627\u0644\u0633\u0627\u0628\u0642\u0629 <span class=\"muted\">Your Previous employment record</span>\r\n</div>\r\n\r\n<div class=\"box\">\r\n\r\n  {# ---------- Previous Jobs: show up to 3 blocks like PDF ---------- #}\r\n  {% set jobs = doc.previous_jobs or [] %}\r\n  {% for i in range(0,3) %}\r\n    {% set j = jobs[i] if jobs|length > i else None %}\r\n\r\n    <table style=\"margin-top:{{ '0' if i==0 else '6px' }};\">\r\n      <tr>\r\n        <td style=\"width:18%;\">\r\n          <div class=\"lbl\">Salary( ) <span class=\"rtl\">\u0627\u0644\u0631\u0627\u062a\u0628</span></div>\r\n          <div>{{ j.salary if j else \"\" }}</div>\r\n          <div class=\"lbl\" style=\"margin-top:6px;\">Allowance( ) <span class=\"rtl\">\u0627\u0644\u0628\u062f\u0644\u0627\u062a</span></div>\r\n          <div>{{ j.allowance if j else \"\" }}</div>\r\n          <div class=\"lbl\" style=\"margin-top:6px;\">Reason for Quit <span class=\"rtl\">\u0633\u0628\u0628 \u062a\u0631\u0643 \u0627\u0644\u0639\u0645\u0644</span></div>\r\n          <div>{{ j.reason_for_quit if j else \"\" }}</div>\r\n        </td>\r\n\r\n        <td style=\"width:40%;\">\r\n          <div class=\"lbl\">Job Title <span class=\"rtl\">\u0645\u0633\u0645\u0649 \u0627\u0644\u0648\u0638\u064a\u0641\u0629</span></div>\r\n          <div>{{ j.job_title if j else \"\" }}</div>\r\n\r\n          <div class=\"lbl\" style=\"margin-top:6px;\">Description of your duties <span class=\"rtl\">\u062a\u0641\u0627\u0635\u064a\u0644 \u0639\u0646 \u0648\u0627\u062c\u0628\u0627\u062a\u0643</span></div>\r\n          <div>{{ j.duties if j else \"\" }}</div>\r\n        </td>\r\n\r\n        <td style=\"width:42%;\">\r\n          <div style=\"display:flex; gap:6px;\">\r\n            <div style=\"flex:1;\">\r\n              <div class=\"lbl\">from <span class=\"rtl\">\u0645\u0646</span></div>\r\n              <div>{% if j and j.from_date %}{{ frappe.utils.formatdate(j.from_date) }}{% endif %}</div>\r\n            </div>\r\n            <div style=\"flex:1;\">\r\n              <div class=\"lbl\">To <span class=\"rtl\">\u0625\u0644\u0649</span></div>\r\n              <div>{% if j and j.to_date %}{{ frappe.utils.formatdate(j.to_date) }}{% endif %}</div>\r\n            </div>\r\n          </div>\r\n\r\n          <div class=\"lbl\" style=\"margin-top:6px;\">Name of co/Org <span class=\"rtl\">\u0627\u0633\u0645 \u0627\u0644\u0634\u0631\u0643\u0629 / \u0635\u0627\u062d\u0628 \u0627\u0644\u0639\u0645\u0644</span></div>\r\n          <div>{{ j.company_name if j else \"\" }}</div>\r\n\r\n          <div class=\"lbl\" style=\"margin-top:6px;\">Address & Telephone <span class=\"rtl\">\u0627\u0644\u0647\u0627\u062a\u0641 \u0648\u0627\u0644\u0639\u0646\u0648\u0627\u0646</span></div>\r\n          <div>{{ j.address_phone if j else \"\" }}</div>\r\n        </td>\r\n      </tr>\r\n    </table>\r\n  {% endfor %}\r\n\r\n  <div class=\"section-h rtl\" style=\"margin-top:10px;\">\r\n    \u0627\u0644\u062a\u062d\u0635\u064a\u0644 \u0627\u0644\u0639\u0644\u0645\u064a <span class=\"muted\">Education</span>\r\n  </div>\r\n\r\n  <table>\r\n    <tr>\r\n      <td class=\"lbl rtl\">\u0627\u0633\u0645 \u0627\u0644\u0645\u062f\u0631\u0633\u0629 /\u0627\u0644\u062c\u0627\u0645\u0639\u0629 <span class=\"small\">Name of school/University</span></td>\r\n      <td class=\"lbl rtl\">\u0627\u0644\u0645\u062f\u064a\u0646\u0629 / \u0627\u0644\u0628\u0644\u062f <span class=\"small\">City / Town</span></td>\r\n      <td class=\"lbl rtl\">\u0645\u0646 \u062a\u0627\u0631\u064a\u062e <span class=\"small\">From</span></td>\r\n      <td class=\"lbl rtl\">\u0625\u0644\u0649 <span class=\"small\">To</span></td>\r\n      <td class=\"lbl rtl\">\u0627\u0644\u062a\u062e\u0635\u0635 <span class=\"small\">Specialize</span></td>\r\n      <td class=\"lbl rtl\">\u0627\u0644\u062f\u0631\u062c\u0629 <span class=\"small\">Grade</span></td>\r\n    </tr>\r\n    {% for e in (doc.education or []) %}\r\n      <tr>\r\n        <td>{{ e.school_university or \"\" }}</td>\r\n        <td>{{ e.city_country or \"\" }}</td>\r\n        <td>{% if e.from_date %}{{ frappe.utils.formatdate(e.from_date) }}{% endif %}</td>\r\n        <td>{% if e.to_date %}{{ frappe.utils.formatdate(e.to_date) }}{% endif %}</td>\r\n        <td>{{ e.specialize or \"\" }}</td>\r\n        <td>{{ e.grade or \"\" }}</td>\r\n      </tr>\r\n    {% endfor %}\r\n  </table>\r\n\r\n  <div class=\"section-h rtl\" style=\"margin-top:10px;\">\r\n    \u0627\u0644\u062f\u0648\u0631\u0627\u062a \u0627\u0644\u062a\u062f\u0631\u064a\u0628\u064a\u0629 <span class=\"muted\">Training Courses</span>\r\n  </div>\r\n\r\n  <table>\r\n    <tr>\r\n      <td class=\"lbl rtl\">\u0627\u0633\u0645 \u0627\u0644\u0645\u0639\u0647\u062f <span class=\"small\">Name of institute</span></td>\r\n      <td class=\"lbl rtl\">\u0627\u0644\u0645\u062f\u064a\u0646\u0629 / \u0627\u0644\u0628\u0644\u062f <span class=\"small\">City / Town</span></td>\r\n      <td class=\"lbl rtl\">\u0645\u0646 \u062a\u0627\u0631\u064a\u062e <span class=\"small\">From</span></td>\r\n      <td class=\"lbl rtl\">\u0625\u0644\u0649 <span class=\"small\">To</span></td>\r\n      <td class=\"lbl rtl\">\u0627\u0644\u062a\u062e\u0635\u0635 <span class=\"small\">Specialize</span></td>\r\n    </tr>\r\n    {% for t in (doc.training_courses or []) %}\r\n      <tr>\r\n        <td>{{ t.institute or \"\" }}</td>\r\n        <td>{{ t.city_country or \"\" }}</td>\r\n        <td>{% if t.from_date %}{{ frappe.utils.formatdate(t.from_date) }}{% endif %}</td>\r\n        <td>{% if t.to_date %}{{ frappe.utils.formatdate(t.to_date) }}{% endif %}</td>\r\n        <td>{{ t.specialize or \"\" }}</td>\r\n      </tr>\r\n    {% endfor %}\r\n  </table>\r\n\r\n  <div class=\"section-h rtl\" style=\"margin-top:10px;\">\r\n    \u0645\u0639\u0631\u0641\u0629 \u0627\u0644\u0644\u063a\u0627\u062a <span class=\"muted\">Knowledge of languages</span>\r\n  </div>\r\n\r\n  <table>\r\n    <tr>\r\n      <td class=\"lbl\">Language <span class=\"rtl\">\u0627\u0644\u0644\u063a\u0629</span></td>\r\n      <td class=\"lbl center\">Speaking <span class=\"rtl\">\u0627\u0644\u062a\u062d\u062f\u062b</span><div class=\"small muted\">EX / G / F</div></td>\r\n      <td class=\"lbl center\">Reading <span class=\"rtl\">\u0627\u0644\u0642\u0631\u0627\u0621\u0629</span><div class=\"small muted\">EX / G / F</div></td>\r\n      <td class=\"lbl center\">Writing <span class=\"rtl\">\u0627\u0644\u0643\u062a\u0627\u0628\u0629</span><div class=\"small muted\">EX / G / F</div></td>\r\n      <td class=\"lbl center\">Shorthand Speed<div class=\"small rtl\">\u0633\u0631\u0639\u0629 \u0627\u0644\u0627\u062e\u062a\u0632\u0627\u0644</div></td>\r\n      <td class=\"lbl center\">Typing Speed<div class=\"small rtl\">\u0633\u0631\u0639\u0629 \u0627\u0644\u0637\u0628\u0627\u0639\u0629</div></td>\r\n      <td class=\"lbl\">Other skills <span class=\"rtl\">\u0645\u0647\u0627\u0631\u0627\u062a \u0623\u062e\u0631\u0649</span></td>\r\n    </tr>\r\n    {% for l in (doc.languages or []) %}\r\n      <tr>\r\n        <td>{{ l.language or \"\" }}</td>\r\n        <td class=\"center\">{{ l.speaking or \"\" }}</td>\r\n        <td class=\"center\">{{ l.reading or \"\" }}</td>\r\n        <td class=\"center\">{{ l.writing or \"\" }}</td>\r\n        <td class=\"center\">{{ l.shorthand_speed or \"\" }}</td>\r\n        <td class=\"center\">{{ l.typing_speed or \"\" }}</td>\r\n        <td>{{ l.other_skills or \"\" }}</td>\r\n      </tr>\r\n    {% endfor %}\r\n  </table>\r\n\r\n</div>\r\n",
