 "html": "<div class=\"row\">\r\n\r\n  <!-- LEFT: QR + Title -->\r\n  <div class=\"col-xs-4\">\r\n    <div style=\"font-weight:bold;\">\u0641\u0627\u062a\u0648\u0631\u0629 \u0636\u0631\u064a\u0628\u064a\u0629 \u0645\u0628\u0633\u0637\u0629</div>\r\n\r\n    {% if doc.zatca_qr_payload %}\r\n      <img\r\n        src=\"https://api.qrserver.com/v1/create-qr-code/?size=120x120&data={{ doc.zatca_qr_payload | urlencode }}\"\r\n        style=\"margin-top:8px;\"\r\n      >\r\n    {% endif %}\r\n  </div>\r\n\r\n  <!-- RIGHT: Company Info -->\r\n  <div class=\"col-xs-8 text-right\">\r\n    <div style=\"font-weight:bold;\">\r\n      {{ frappe.get_doc(\"Company\", doc.company).company_name_arabic }}\r\n    </div>\r\n\r\n    <div>\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0636\u0631\u064a\u0628\u064a: {{ doc.company_tax_id }}</div>\r\n\r\n    <div>\r\n      \u0633\u062c\u0644 \u062a\u062c\u0627\u0631\u064a:\r\n      {{ frappe.get_doc(\"Company\", doc.company).registration_details }}\r\n    </div>\r\n\r\n    <div style=\"margin-top:4px;\">\r\n      {{ doc.company_address_display | safe }}\r\n    </div>\r\n  </div>\r\n\r\n</div>\r\n\r\n<hr>\r\n<div class=\"row\">\r\n\r\n  <div class=\"col-xs-6\">\r\n    <div><b>\u0631\u0642\u0645 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629:</b> {{ doc.name }}</div>\r\n    <div><b>\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629:</b> {{ doc.posting_date }}</div>\r\n  </div>\r\n\r\n  <div class=\"col-xs-6 text-right\">\r\n    <div><b>\u0641\u0627\u062a\u0648\u0631\u0629 \u0625\u0644\u0649:</b></div>\r\n    <div>{{ doc.customer_name }}</div>\r\n  </div>\r\n\r\n</div>\r\n\r\n<hr>\r\n<table class=\"table table-bordered text-right\">\r\n  <thead>\r\n    <tr>\r\n      <th>\u0627\u0644\u0628\u0646\u062f</th>\r\n      <th>\u0633\u0639\u0631 \u0627\u0644\u0648\u062d\u062f\u0629</th>\r\n      <th>\u0627\u0644\u0643\u0645\u064a\u0629</th>\r\n      <th>\u0627\u0644\u0645\u062c\u0645\u0648\u0639</th>\r\n    </tr>\r\n  </thead>\r\n  <tbody>\r\n    {% for row in doc.items %}\r\n    <tr>\r\n      <td>{{ row.item_name }}</td>\r\n      <td>{{ frappe.format(row.rate, {\"fieldtype\":\"Currency\"}, doc) }}</td>\r\n      <td>{{ row.qty }}</td>\r\n      <td>{{ frappe.format(row.amount, {\"fieldtype\":\"Currency\"}, doc) }}</td>\r\n    </tr>\r\n    {% endfor %}\r\n  </tbody>\r\n</table>\r\n\r\n<table class=\"table table-bordered text-right\" style=\"width:50%; float:left;\">\r\n  <tr>\r\n    <td>\u0627\u0644\u0645\u062c\u0645\u0648\u0639:</td>\r\n    <td>{{ frappe.format(doc.net_total, {\"fieldtype\":\"Currency\"}, doc) }}</td>\r\n  </tr>\r\n\r\n  <tr>\r\n    <td>\u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0645\u0636\u0627\u0641\u0629 (15%):</td>\r\n    <td>{{ frappe.format(doc.total_taxes_and_charges, {\"fieldtype\":\"Currency\"}, doc) }}</td>\r\n  </tr>\r\n\r\n  <tr>\r\n    <td><b>\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a:</b></td>\r\n    <td><b>{{ frappe.format(doc.grand_total, {\"fieldtype\":\"Currency\"}, doc) }}</b></td>\r\n  </tr>\r\n\r\n  <tr>\r\n    <td>\u0645\u062f\u0641\u0648\u0639\u0629:</td>\r\n    <td>{{ frappe.format(doc.paid_amount or 0, {\"fieldtype\":\"Currency\"}, doc) }}</td>\r\n  </tr>\r\n\r\n  <tr>\r\n    <td>\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0645\u0633\u062a\u062d\u0642:</td>\r\n    <td>{{ frappe.format(doc.outstanding_amount, {\"fieldtype\":\"Currency\"}, doc) }}</td>\r\n  </tr>\r\n</table>\r\n\r\n<div style=\"clear:both;\"></div>\r\n\r\n",
