 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\r\n@import url('https://fonts.googleapis.com/css2?family=Almarai:wght@300;400;700;800&family=Tajawal:wght@200;300;400;500;700;800;900&display=swap');\r\n\r\n@page { size: A4; margin: 10mm 8mm 10mm 8mm; }\r\n\r\nbody { font-family: \"Noto Sans Arabic\", \"Noto Kufi Arabic\", Tahoma, Arial, sans-serif; }\r\nhr { border: 0; border-top: 1px solid #ddd; margin: 8px 0; }\r\n\r\n.header-wrap { display: flex; justify-content: space-between; align-items: flex-start; }\r\n.header-left { width: 35%; }\r\n.header-right { width: 63%; text-align: right; direction: rtl; }\r\n\r\n\r\n.company-en { font-size: 12px; margin: 2px 0 6px 0; direction:ltr; text-align:right; color:#333; }\r\n.company-names .ar {\r\n  margin: 0;\r\n  font-size: 22px;\r\n  font-family:'Cascadia Mono', monospace;\r\n  font-weight: 500;\r\n  color: #000;\r\n  direction: rtl;\r\n}\r\n.small { font-size: 12px; color:#333; }\r\n.qr { width: 115px; height: 115px; }\r\n\r\n.info-row { display:flex; justify-content: space-between; margin-top: 6px; }\r\n.info-left { width: 48%; direction: rtl; text-align: right; }\r\n.info-right { width: 48%; direction: rtl; text-align: right; }\r\n\r\n.table { width:100%; border-collapse: collapse; table-layout: fixed; direction: rtl; }\r\n.table th { background:#f3f3f3; border:1px solid #bbb; padding:6px; text-align:right; font-weight:700; }\r\n.table td { border:1px solid #bbb; padding:6px; text-align:right; vertical-align:top; }\r\n\r\n.num { direction:ltr; text-align:right; }   /* keeps numbers nice in RTL */\r\n.totals { width: 55%; float:left; direction: rtl; }\r\n.totals td { border:1px solid #bbb; }\r\n.clear { clear: both; }\r\n</style>\r\n\r\n{% set company = frappe.get_doc(\"Company\", doc.company) %}\r\n\r\n<div class=\"header-wrap\">\r\n  <!-- Left: Title + QR -->\r\n  <div class=\"header-left\" style=\"direction:rtl;\">\r\n    <div style=\"font-weight:700;\">\u0641\u0627\u062a\u0648\u0631\u0629 \u0636\u0631\u064a\u0628\u064a\u0629 \u0645\u0628\u0633\u0637\u0629</div>\r\n    {% if doc.zatca_qr_payload %}\r\n      <img class=\"qr\"\r\n           src=\"https://api.qrserver.com/v1/create-qr-code/?size=140x140&data={{ doc.zatca_qr_payload | urlencode }}\"\r\n           alt=\"QR\">\r\n    {% endif %}\r\n  </div>\r\n\r\n  <!-- Right: Company -->\r\n  <div class=\"header-right\">\r\n    <p class=\"ar\">{{ company.company_name_arabic or company.company_name }}</p>\r\n    {% if company.company_name_arabic and company.company_name %}\r\n      <p class=\"company-en\">{{ company.company_name }}</p>\r\n    {% endif %}\r\n\r\n    <div class=\"small\">\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0636\u0631\u064a\u0628\u064a: <span class=\"num\">{{ doc.company_tax_id or company.tax_id or \"\" }}</span></div>\r\n    {% if company.registration_details %}\r\n      <div class=\"small\">\u0633\u062c\u0644 \u062a\u062c\u0627\u0631\u064a: <span class=\"num\">{{ company.registration_details }}</span></div>\r\n    {% endif %}\r\n    {% if doc.company_address_display %}\r\n      <div class=\"small\" style=\"margin-top:4px;\">{{ doc.company_address_display | safe }}</div>\r\n    {% endif %}\r\n  </div>\r\n</div>\r\n\r\n<hr>\r\n\r\n<div class=\"info-row\">\r\n  <div class=\"info-left\">\r\n    <div><b>\u0631\u0642\u0645 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629:</b> <span class=\"num\">{{ doc.name }}</span></div>\r\n    <div><b>\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629:</b> <span class=\"num\">{{ doc.posting_date }}</span></div>\r\n  </div>\r\n\r\n  <div class=\"info-right\">\r\n    <div><b>\u0641\u0627\u062a\u0648\u0631\u0629 \u0625\u0644\u0649:</b> {{ doc.customer_name }}</div>\r\n    {% if doc.tax_id %}\r\n      <div><b>\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0636\u0631\u064a\u0628\u064a \u0644\u0644\u0639\u0645\u064a\u0644:</b> <span class=\"num\">{{ doc.tax_id }}</span></div>\r\n    {% endif %}\r\n  </div>\r\n</div>\r\n\r\n<hr>\r\n\r\n<table class=\"table\">\r\n  <thead>\r\n    <tr>\r\n      <th style=\"width:45%;\">\u0627\u0644\u0628\u0646\u062f</th>\r\n      <th style=\"width:18%;\">\u0633\u0639\u0631 \u0627\u0644\u0648\u062d\u062f\u0629</th>\r\n      <th style=\"width:12%;\">\u0627\u0644\u0643\u0645\u064a\u0629</th>\r\n      <th style=\"width:25%;\">\u0627\u0644\u0645\u062c\u0645\u0648\u0639</th>\r\n    </tr>\r\n  </thead>\r\n  <tbody>\r\n    {% for row in doc.items %}\r\n    <tr>\r\n      <td>{{ row.item_name }}</td>\r\n      <td class=\"num\">{{ frappe.format(row.rate, {\"fieldtype\":\"Currency\"}, doc) }}</td>\r\n      <td class=\"num\">{{ row.qty }}</td>\r\n      <td class=\"num\">{{ frappe.format(row.amount, {\"fieldtype\":\"Currency\"}, doc) }}</td>\r\n    </tr>\r\n    {% endfor %}\r\n  </tbody>\r\n</table>\r\n\r\n<br>\r\n\r\n<table class=\"table totals\">\r\n  <tr>\r\n    <td>\u0627\u0644\u0645\u062c\u0645\u0648\u0639:</td>\r\n    <td class=\"num\">{{ frappe.format(doc.net_total, {\"fieldtype\":\"Currency\"}, doc) }}</td>\r\n  </tr>\r\n  <tr>\r\n    <td>\u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0645\u0636\u0627\u0641\u0629 (15%):</td>\r\n    <td class=\"num\">{{ frappe.format(doc.total_taxes_and_charges, {\"fieldtype\":\"Currency\"}, doc) }}</td>\r\n  </tr>\r\n  <tr>\r\n    <td><b>\u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a:</b></td>\r\n    <td class=\"num\"><b>{{ frappe.format(doc.grand_total, {\"fieldtype\":\"Currency\"}, doc) }}</b></td>\r\n  </tr>\r\n  <tr>\r\n    <td>\u0645\u062f\u0641\u0648\u0639\u0629:</td>\r\n    <td class=\"num\">{{ frappe.format(doc.paid_amount or 0, {\"fieldtype\":\"Currency\"}, doc) }}</td>\r\n  </tr>\r\n  <tr>\r\n    <td>\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0645\u0633\u062a\u062d\u0642:</td>\r\n    <td class=\"num\">{{ frappe.format(doc.outstanding_amount, {\"fieldtype\":\"Currency\"}, doc) }}</td>\r\n  </tr>\r\n</table>\r\n\r\n<div class=\"clear\"></div>\r\n",
